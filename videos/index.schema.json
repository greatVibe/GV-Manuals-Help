{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greatvibe.example/schemas/video-index.schema.json",
  "title": "GreatVibe video catalogue",
  "type": "object",
  "required": ["version", "updated_at", "videos"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "default_aspect_ratio": {
      "type": "string",
      "pattern": "^[1-9][0-9]*:[1-9][0-9]*$",
      "default": "1:1"
    },
    "videos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/video"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "video": {
      "type": "object",
      "required": [
        "slug",
        "title",
        "provider",
        "video_id",
        "aspect_ratio",
        "product_area",
        "audience",
        "trust",
        "visibility",
        "tags",
        "related_docs"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        },
        "provider": {
          "type": "string",
          "enum": ["vimeo", "youtube"]
        },
        "video_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "embed_hash_ref": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "product_area": {
          "type": "string",
          "minLength": 2
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "difficulty": {
          "type": "string",
          "enum": ["intro", "beginner", "intermediate", "advanced"]
        },
        "trust": {
          "type": "string",
          "enum": ["owned", "curated", "external"]
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "unlisted-overlay-required", "private"]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "related_docs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "transcript_path": {
          "type": "string"
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start_seconds", "title"],
            "additionalProperties": false,
            "properties": {
              "start_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "title": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              }
            }
          }
        },
        "updated_at": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
